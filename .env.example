# ===== LLM Provider（v2.7 默认用 DeepSeek 比 Claude 便宜 1/20，国内无需代理）=====
# DeepSeek 调用 OpenAI 兼容协议，使用 DEEPSEEK_API_KEY
# 获取：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# 可选：仅当用 Claude 走 Anthropic SDK 才需要
# ANTHROPIC_API_KEY=
# 可选：阿里云 DashScope（Qwen / Qwen-VL）
# DASHSCOPE_API_KEY=
# 可选：智谱 GLM-4 / GL-4V
# ZHIPU_API_KEY=
# 可选：月之暗面 Kimi 128K
# KIMI_API_KEY=
# 可选：百度文心 ERNIE-4.0
# WENXIN_API_KEY=
# WENXIN_SECRET_KEY=
# 可选：OpenAI（国外补充）
# OPENAI_API_KEY=
# 可选：本地 Ollama（推荐 Qwen2-7B）
# MYHOME_LOCAL_LLM_URL=http://localhost:11434
# MYHOME_LOCAL_LLM_MODEL=qwen2:7b-instruct

# ===== KMS（主密钥派生）=====
# v1.0 强烈推荐：从 .env 移除，明文存 db 改为 KMS 派生
# MYHOME_KMS_PASSPHRASE=
# MYHOME_KMS_SALT=myhome-v1.0

# ===== 米家云端账号（可选：用于米家设备发现 / token 获取 / 云端控制回退）=====
# 跨生态后仍然保留对米家设备的兼容（仍是首家最广泛用户群）
MI_USERNAME=
MI_PASSWORD=
# 服务器区域: cn / de / us / ru / tw / sg / in
MI_REGION=cn

# ===== Telegram bot（可选，远程控制用）=====
# 创建：Telegram 搜 @BotFather → /newbot
# TELEGRAM_BOT_TOKEN=

# ===== 数据库 =====
MYHOME_DB_PATH=./data/myhome.db

# ===== 服务 =====
MYHOME_HOST=0.0.0.0
MYHOME_PORT=8300

# ===== LLM 路由（v3.0 国货优先）=====
# 月度预算上限 USD
MYHOME_LLM_BUDGET=20.0
# 国产 LLM 预算占比（0.0-1.0）
MYHOME_LLM_CN_PCT=0.8
# 默认 provider（deepseek / qwen / kimi / zhipu / wenxin / auto）
MYHOME_LLM_PREFERRED=deepseek
# 隐私模式：public | sensitive
MYHOME_LLM_PRIVACY=public
